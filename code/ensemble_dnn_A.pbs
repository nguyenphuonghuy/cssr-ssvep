#!/bin/bash
#PBS -N ton_ed_A
#PBS -q sharedgpu
#PBS -l select=1:ncpus=8:mem=32gb:gpu_slots=1
#PBS -l walltime=24:00:00
#PBS -j oe
#PBS -o /gpfs0/users/gv_dnton/projects/qldanc_ton_b1/logs/pbs/
# Job A tai hien Ensemble-DNN: ED-du Benchmark (cong tai hien truoc), ED-22 Benchmark va BETA.
set -euo pipefail
P=/gpfs0/users/gv_dnton/projects/qldanc_ton_b1
PY=/gpfs0/users/gv_nphuy/envs/eeg-torch27/bin/python
exec > $P/logs/ed_A_${PBS_JOBID}.log 2>&1
export CUDA_MPS_PIPE_DIRECTORY=/dev/null
export OMP_NUM_THREADS=2 MKL_NUM_THREADS=2 PYTHONUNBUFFERED=1
cd $P
R=$P/results/b1moi_ed
mkdir -p $R
sha256sum scripts/ensemble_dnn.py scripts/ensemble_dnn_phan_tich.py scripts/global_dnn.py scripts/global_dnn_thichnghi.py scripts/b1_diem.py
nvidia-smi --query-gpu=name,memory.total --format=csv
chay() {   # $1 ds, $2 T, $3 bien the, $4 thu muc ra, $5 trong so (22), $6 timeout
  local pids=()
  for k in 1 2 3 4; do
    timeout $6 $PY scripts/ensemble_dnn.py --ds $1 --T $2 --bien-the $3 ${5:+--trongso $5} --folds $k::4 --out $4 > $4.w$k.log 2>&1 &
    pids+=($!)
  done
  local loi=0
  for p in "${pids[@]}"; do wait $p || loi=1; done
  if [ $loi -ne 0 ]; then echo "LOI tien trinh con ($1 $2 $3); xem $4.w*.log"; exit 1; fi
}
# chay thu thong (1 fold, 1 vong moi giai doan, khong in so)
rm -rf $R/_thu
timeout 30m $PY scripts/ensemble_dnn.py --ds benchmark --T 0.6 --bien-the du --folds 1::35 --vong1 1 --vong2 1 --out $R/_thu
timeout 30m $PY scripts/ensemble_dnn.py --ds beta --T 0.6 --bien-the 22 --trongso results/b1moi_lai_beta/T06 --folds 1::70 --vong2 1 --out $R/_thu22
chay benchmark 1.0 du $R/du_benchmark_T10 "" 4h
$PY scripts/ensemble_dnn_phan_tich.py cong $R/du_benchmark_T10
chay benchmark 0.6 du $R/du_benchmark_T06 "" 4h
chay benchmark 1.0 22 $R/22_benchmark_T10 results/b1v7_lo2/T10 3h
chay benchmark 0.6 22 $R/22_benchmark_T06 results/b1v7_lo2/T06 3h
chay beta 1.0 22 $R/22_beta_T10 results/b1moi_lai_beta/T10 4h
chay beta 0.6 22 $R/22_beta_T06 results/b1moi_lai_beta/T06 4h
echo XONG
