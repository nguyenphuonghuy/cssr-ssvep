#!/bin/bash
#PBS -N ton_ktnr_b1
#PBS -q sharedgpu
#PBS -l select=1:ncpus=8:mem=32gb:gpu_slots=1
#PBS -l walltime=10:00:00
#PBS -j oe
#PBS -o /gpfs0/users/gv_dnton/projects/qldanc_ton_b1/logs/pbs/
# KTN-R buoc 1: phat lai KTN + nhanh R tren Benchmark, BETA, eldBETA bang mang nen da co.
set -euo pipefail
P=/gpfs0/users/gv_dnton/projects/qldanc_ton_b1
PY=/gpfs0/users/gv_nphuy/envs/eeg-torch27/bin/python
exec > $P/logs/ktnr_b1_${PBS_JOBID}.log 2>&1
export CUDA_MPS_PIPE_DIRECTORY=/dev/null
export OMP_NUM_THREADS=2 MKL_NUM_THREADS=2 PYTHONUNBUFFERED=1
cd $P
R=$P/results/b1moi_ktnr
mkdir -p $R
sha256sum scripts/ktnr_buoc1.py scripts/ktnr_buoc1_phan_tich.py scripts/b1moi_lai.py scripts/b1_diem.py scripts/global_dnn.py scripts/du_lieu_eld.py
nvidia-smi --query-gpu=name,memory.total --format=csv
# chay thu thong (1 fold, khong dung so)
rm -f $R/_thu.json $R/_thu.json.dang-chay.tmp
timeout 30m $PY scripts/ktnr_buoc1.py --ds benchmark --T 1.0 --trongso results/b1v7_lo2/T10 --folds 1 --out $R/_thu.json > /dev/null
# cong som: fold 1 phai trung SF va nguon chon cua job 18691 (khong in so do chinh xac)
$PY -c "import json,sys; a=json.load(open('$R/_thu.json'))['tung_nguoi'][0]; b=json.load(open('results/b1moi_lai/benchmark_b1moi_lai_T10_seed20261107_20261114.json'))['tung_nguoi'][0]['B']; ok=abs(a['ktn']-b['SF']['sau'])<1e-9 and a['nguon_chon']==b['nguon_chon']; print('CONG SOM', 'DAT' if ok else 'KHONG DAT'); sys.exit(0 if ok else 4)"
D=$(date +%Y%m%d)
timeout 1h $PY scripts/ktnr_buoc1.py --ds benchmark --T 1.0 --trongso results/b1v7_lo2/T10 --out $R/benchmark_ktnr-buoc1_T10_seed20261107_$D.json
timeout 1h $PY scripts/ktnr_buoc1.py --ds benchmark --T 0.6 --trongso results/b1v7_lo2/T06 --out $R/benchmark_ktnr-buoc1_T06_seed20261107_$D.json
timeout 2h $PY scripts/ktnr_buoc1.py --ds beta --T 1.0 --trongso results/b1moi_lai_beta/T10 --out $R/beta_ktnr-buoc1_T10_seed20261107_$D.json
timeout 2h $PY scripts/ktnr_buoc1.py --ds beta --T 0.6 --trongso results/b1moi_lai_beta/T06 --out $R/beta_ktnr-buoc1_T06_seed20261107_$D.json
timeout 2h $PY scripts/ktnr_buoc1.py --ds eld --T 1.0 --trongso results/b1moi_lai_eld/T10 --out $R/eldbeta_ktnr-buoc1_T10_seed20261107_$D.json
timeout 2h $PY scripts/ktnr_buoc1.py --ds eld --T 0.6 --trongso results/b1moi_lai_eld/T06 --out $R/eldbeta_ktnr-buoc1_T06_seed20261107_$D.json
echo XONG
