#!/bin/bash
#PBS -N ton_b1moi_eld
#PBS -q sharedgpu
#PBS -l select=1:ncpus=8:mem=32gb:gpu_slots=0
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -o /gpfs0/users/gv_dnton/projects/qldanc_ton_b1/logs/pbs/
# B1 v6: LO 1 cai tien. Job ngan (uoc < 30 phut).
P=/gpfs0/users/gv_dnton/projects/qldanc_ton_b1
PY=/gpfs0/users/gv_nphuy/envs/eeg-torch27/bin/python
exec > $P/logs/b1moi_eld_${PBS_JOBID}.log 2>&1
export OMP_NUM_THREADS=8 MKL_NUM_THREADS=8 OPENBLAS_NUM_THREADS=8 PYTHONUNBUFFERED=1
cd $P
mkdir -p results/b1moi_zhu
sha256sum scripts/b1moi_eld.py scripts/b1_diem.py
mkdir -p results/b1moi_eld
$PY scripts/b1moi_eld.py --out results/b1moi_eld/eldbeta_b1moi_kh_seed20261107_20261114.json
