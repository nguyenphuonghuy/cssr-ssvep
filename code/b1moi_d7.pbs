#!/bin/bash
#PBS -N ton_d7
#PBS -q sharedgpu
#PBS -l select=1:ncpus=8:mem=32gb:gpu_slots=1
#PBS -l walltime=24:00:00
#PBS -j oe
#PBS -o /gpfs0/users/gv_dnton/projects/qldanc_ton_b1/logs/pbs/
# D7 tach co che KTN. Uoc 1-2 gio GPU.
set -euo pipefail
P=/gpfs0/users/gv_dnton/projects/qldanc_ton_b1
PY=/gpfs0/users/gv_nphuy/envs/eeg-torch27/bin/python
exec > $P/logs/b1moi_d7_${PBS_JOBID}.log 2>&1
export CUDA_MPS_PIPE_DIRECTORY=/dev/null
export OMP_NUM_THREADS=2 MKL_NUM_THREADS=2 PYTHONUNBUFFERED=1
cd $P
R=$P/results/b1moi_d7
mkdir -p $R
sha256sum scripts/b1moi_lai_hoiquy.py scripts/global_dnn_huanluyen.py scripts/global_dnn_thichnghi.py scripts/global_dnn.py scripts/b1moi_lai.py scripts/b1_diem.py
nvidia-smi --query-gpu=name,memory.total --format=csv

# kiem hoi quy truoc: Benchmark 1,0 s, che do xac nhan (SF_B phai trung job 18691)
timeout 1h $PY scripts/b1moi_lai.py --ds benchmark --xac-nhan --T 1.0 --trongso results/b1v7_lo2/T10 --out $R/benchmark_b1moi_lai-xn-hoiquy_T10_seed20261107_20261114.json
$PY scripts/b1moi_lai_hoiquy.py $R/benchmark_b1moi_lai-xn-hoiquy_T10_seed20261107_20261114.json results/b1moi_lai/benchmark_b1moi_lai_T10_seed20261107_20261114.json

# D7: doi chung tach co che KTN; khong huan luyen mang nen moi
for T in 10 06; do
  TT=$([ $T = 10 ] && echo 1.0 || echo 0.6)
  timeout 2h $PY scripts/b1moi_lai.py --ds benchmark --xac-nhan --d7 --T $TT --trongso results/b1v7_lo2/T$T --out $R/benchmark_b1moi_d7_T${T}_seed20261107_20261115.json
  timeout 3h $PY scripts/b1moi_lai.py --ds beta --xac-nhan --d7 --T $TT --trongso results/b1moi_lai_beta/T$T --out $R/beta_b1moi_d7_T${T}_seed20261107_20261115.json
  timeout 3h $PY scripts/b1moi_lai.py --ds eld --xac-nhan --d7 --T $TT --trongso results/b1moi_lai_eld/T$T --out $R/eldbeta_b1moi_d7_T${T}_seed20261107_20261115.json
done
echo XONG
