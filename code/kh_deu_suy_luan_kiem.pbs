#!/bin/bash
#PBS -N ton_khdeu_kiem
#PBS -q sharedgpu
#PBS -l select=1:ncpus=8:mem=32gb:gpu_slots=0
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -o /gpfs0/users/gv_dnton/projects/qldanc_ton_b1/logs/pbs/
# Kiem ban suy luan that cua kh_deu trung ma mo phong (Benchmark, BETA). CPU ngan.
set -euo pipefail
P=/gpfs0/users/gv_dnton/projects/qldanc_ton_b1
PY=/gpfs0/users/gv_nphuy/envs/eeg-torch27/bin/python
exec > $P/logs/khdeu_kiem_${PBS_JOBID}.log 2>&1
export OMP_NUM_THREADS=8 MKL_NUM_THREADS=8 OPENBLAS_NUM_THREADS=8 PYTHONUNBUFFERED=1
cd $P
mkdir -p results/b1moi_suyluan
sha256sum scripts/kh_deu_suy_luan.py scripts/b1_diem.py
$PY scripts/kh_deu_suy_luan.py --kiem benchmark --json results/b1moi_buoc0/benchmark_b1moi_buoc0b_seed20261107_20261114.json --out results/b1moi_suyluan/benchmark_khdeu-suy-luan-kiem_seed20261107_20261114.json
$PY scripts/kh_deu_suy_luan.py --kiem beta --json results/b1moi_buoc0/beta_b1moi_buoc0b_seed20261107_20261114.json --out results/b1moi_suyluan/beta_khdeu-suy-luan-kiem_seed20261107_20261114.json
