#!/bin/bash
#PBS -N ton_lai
#PBS -q sharedgpu
#PBS -l select=1:ncpus=8:mem=32gb:gpu_slots=1
#PBS -l walltime=24:00:00
#PBS -j oe
#PBS -o /gpfs0/users/gv_dnton/projects/qldanc_ton_b1/logs/pbs/
# Phep thu 2 x 2: chon nguon de khoi tao mo-dun thich nghi nho. Uoc 2-4 gio GPU.
set -euo pipefail
P=/gpfs0/users/gv_dnton/projects/qldanc_ton_b1
PY=/gpfs0/users/gv_nphuy/envs/eeg-torch27/bin/python
exec > $P/logs/b1moi_lai_${PBS_JOBID}.log 2>&1
export CUDA_MPS_PIPE_DIRECTORY=/dev/null
export OMP_NUM_THREADS=4 MKL_NUM_THREADS=4 PYTHONUNBUFFERED=1
cd $P
mkdir -p results/b1moi_lai
sha256sum scripts/b1moi_lai.py scripts/global_dnn.py scripts/b1_diem.py
nvidia-smi --query-gpu=name,memory.total --format=csv
O=results/b1moi_lai
timeout 1h $PY scripts/b1moi_lai.py --T 1.0 --trongso results/b1v7_lo2/T10 --folds 2 --im-lang --out $O/_thu_khong_ghi.json
timeout 11h $PY scripts/b1moi_lai.py --T 1.0 --trongso results/b1v7_lo2/T10 --out $O/benchmark_b1moi_lai_T10_seed20261107_20261114.json
timeout 11h $PY scripts/b1moi_lai.py --T 0.6 --trongso results/b1v7_lo2/T06 --out $O/benchmark_b1moi_lai_T06_seed20261107_20261114.json
